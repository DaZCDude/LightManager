<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.LightManager" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.LightManager.Splash" parent="Theme.LightManager">
        <!-- Background color -->
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <!-- Your app logo -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_monochrome</item>
        <!-- Animation duration -->
        <item name="android:windowSplashScreenAnimationDuration">500</item>
    </style>
</resources>